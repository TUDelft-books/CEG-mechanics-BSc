     "data": {
      "text/latex": [
       "$\\displaystyle \\frac{4 M}{3 EI} + \\frac{200}{3 EI}$"
      ],
      "text/plain": [
       "4*M/(3*EI) + 200/(3*EI)"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "data": {
      "text/latex": [
       "$\\displaystyle - \\frac{2 M}{EI}$"
      ],
      "text/plain": [
       "-2*M/EI"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "data": {
      "text/latex": [
       "$\\displaystyle -20$"
      ],
      "text/plain": [
       "-20"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "EI, q, L1, L2, M = sym.symbols('EI q L1 L2 M')\n",
    "\n",
    "L1 = 4\n",
    "L2 = 6\n",
    "\n",
    "q = 25\n",
    "\n",
    "phi_1 = M * L1 / EI / 3 + q * L1**3 / EI / 24\n",
    "phi_2 = - M * L2 / EI / 3\n",
    "\n",
    "display(phi_1, phi_2)\n",
    "eq = sym.Eq(phi_1, phi_2)\n",
    "\n",
    "sol = sym.solve(eq, M)[0]\n",
    "display(sol)"
   ]
  },
